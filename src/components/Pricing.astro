---
import { STRIPE_URL, RELEASES_URL } from '../lib/constants';

const freeTier = ['Smart Screenshot','Prompt Optimizer','Custom Action Buttons','Agent Monitor','Prompt History','Educational Shorts'];
const proTier = ['Everything in Free','Voice Input','Workspace Snapshots','Preview CSS editing','Priority support'];
---

<section id="pricing" class="px-6 sm:px-12 lg:px-24 py-24">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16 max-w-lg">
      <p class="section-label mb-4">03 &mdash; Pricing</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Start free.<br/>Upgrade when you need more.</h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 max-w-2xl">
      <!-- Free tier -->
      <div>
        <div class="mb-6">
          <p class="mono text-xs text-[#b0aca6] uppercase tracking-wider mb-2">Free</p>
          <p class="text-5xl font-bold tracking-tight">$0</p>
          <p class="text-sm text-[#b0aca6] mt-1">Forever</p>
        </div>
        <ul class="flex flex-col gap-3 mb-8">
          {freeTier.map((f) => (
            <li class="flex items-start gap-2.5 text-sm text-[#6b6560]">
              <span class="text-[#e85720] mt-0.5">&check;</span>
              {f}
            </li>
          ))}
        </ul>
        <a href={RELEASES_URL} class="block text-center py-2.5 px-4 rounded-lg border border-[#e8e6e1] hover:border-[#1a1a1a] text-sm font-medium transition-colors">
          Download free
        </a>
      </div>

      <!-- Pro tier -->
      <div class="bg-[#1a1a1a] text-[#faf9f7] rounded-2xl p-8">
        <div class="mb-6">
          <p class="mono text-xs text-[#e85720] uppercase tracking-wider mb-2">Pro</p>
          <p class="text-5xl font-bold tracking-tight">$4</p>
          <p class="text-sm text-[#999] mt-1">per month</p>
        </div>
        <ul class="flex flex-col gap-3 mb-8">
          {proTier.map((f) => (
            <li class="flex items-start gap-2.5 text-sm text-[#ccc]">
              <span class="text-[#e85720] mt-0.5">&check;</span>
              {f}
            </li>
          ))}
        </ul>
        <a href={STRIPE_URL} class="block text-center py-2.5 px-4 rounded-lg bg-[#e85720] hover:bg-[#d14d1c] text-[#faf9f7] text-sm font-semibold transition-colors">
          Get Pro
        </a>
      </div>
    </div>
  </div>
</section>

<div class="divider max-w-6xl"></div>
