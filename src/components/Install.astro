---
import { RELEASES_URL } from '../lib/constants';
---

<section id="install" class="px-6 sm:px-12 lg:px-24 py-24">
  <div class="max-w-6xl mx-auto">
    <div class="mb-16 max-w-lg">
      <p class="section-label mb-4">04 &mdash; Install</p>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Up in 60 seconds.</h2>
      <p class="text-[#6b6560] text-base leading-relaxed">No configuration. No account required.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-12 max-w-3xl mb-16">
      <div>
        <p class="mono text-3xl font-medium text-[#e85720] mb-3">01</p>
        <h3 class="font-semibold mb-2">Download the .dmg</h3>
        <p class="text-sm text-[#6b6560] leading-relaxed">Get the latest beta from GitHub Releases.</p>
      </div>
      <div>
        <p class="mono text-3xl font-medium text-[#e85720] mb-3">02</p>
        <h3 class="font-semibold mb-2">Drag to Applications</h3>
        <p class="text-sm text-[#6b6560] leading-relaxed">Open the .dmg and drag DevDock to your Applications folder.</p>
      </div>
      <div>
        <p class="mono text-3xl font-medium text-[#e85720] mb-3">03</p>
        <h3 class="font-semibold mb-2">Launch &mdash; dock appears</h3>
        <p class="text-sm text-[#6b6560] leading-relaxed">Open from Applications or Spotlight. The dock floats above all windows.</p>
      </div>
    </div>

    <a href={RELEASES_URL} class="inline-flex items-center gap-2.5 px-6 py-3 bg-[#1a1a1a] hover:bg-[#333] text-[#faf9f7] text-sm font-medium rounded-lg transition-colors">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
      Download for macOS
    </a>
    <p class="text-xs text-[#b0aca6] mt-3 mono">Requires macOS 12 Monterey or later</p>
  </div>
</section>
