---
import { RELEASES_URL } from '../lib/constants';
---

<section class="min-h-[90vh] flex items-center px-6 sm:px-12 lg:px-24 py-32">
  <div class="max-w-6xl mx-auto w-full grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">
    <div>
      <p class="section-label mb-6">01 &mdash; DevDock</p>

      <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-bold tracking-tight leading-[1.1] mb-8 text-[#1a1a1a]">
        A floating dock<br/>
        for developers who<br/>
        <em class="not-italic accent">think with AI.</em>
      </h1>

      <p class="text-lg text-[#6b6560] max-w-md mb-10 leading-relaxed">
        Smart screenshots, prompt optimization, voice input, and agent
        monitoring &mdash; always on top, never in the way.
      </p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href={RELEASES_URL}
          class="inline-flex items-center gap-2.5 px-6 py-3 bg-[#1a1a1a] hover:bg-[#333] text-[#faf9f7] text-sm font-medium rounded-lg transition-colors"
        >
          <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Download for macOS
        </a>
        <a
          href="#features"
          class="text-sm text-[#6b6560] hover:text-[#1a1a1a] font-medium transition-colors"
        >
          See features &darr;
        </a>
      </div>

      <p class="text-xs text-[#b0aca6] mt-6 mono">macOS 12+ &middot; Apple Silicon &amp; Intel &middot; Free</p>
    </div>

    <div class="relative">
      <div class="aspect-[4/3] bg-[#f0eee9] rounded-2xl overflow-hidden border border-[#e8e6e1]">
        <video autoplay loop muted playsinline class="w-full h-full object-cover">
          <source src="/devdock-site/demo.mp4" type="video/mp4" />
          <div class="w-full h-full flex items-center justify-center">
            <img src="/devdock-site/favicon.svg" alt="DevDock" class="w-16 h-16 opacity-30" />
          </div>
        </video>
      </div>
      <div class="absolute -bottom-4 -right-4 bg-[#faf9f7] border border-[#e8e6e1] rounded-xl px-4 py-3 shadow-sm">
        <p class="mono text-xs text-[#6b6560]">
          <span class="inline-block w-2 h-2 rounded-full bg-[#22c55e] mr-2"></span>
          Beta available
        </p>
      </div>
    </div>
  </div>
</section>

<div class="divider max-w-6xl"></div>
